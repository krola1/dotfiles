// ==========================================================
// WINDOW RULES
// ==========================================================

// --- generic rules ---
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// --- app-specific rules ---

// Work around WezTerm initial configure bug
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox picture-in-picture should float
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Floating Kitty scratch / popup terminal
window-rule {
    match app-id="floatingKitty"
    open-floating true
    default-column-width { fixed 768; }
    default-window-height { fixed 480; }
    // default-column-width { proportion 0.4; }
    // default-window-height { proportion 0.4; }
    // default-floating-position x=10 y=10 relative-to="top"
}

// Example: block out apps from screen capture
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
    // block-out-from "screencast"
}
