// Krever patchet niri (niri-git fra PR #2997) for "hidden true" - se ../NIRI-GIT-SETUP.md
// ikke i bruk nå (bindene under bruker niri-stash-toggle, ikke registre) - la stå i tilfelle create/delete/get trengs igjen
// spawn-at-startup "niri-scratchpad" "daemon"


workspace "stash" {
    hidden true    // bare på hidden-workspaces-branchen
}

binds {
    Mod+S { spawn "niri-stash-toggle"; }
    Mod+Shift+S { move-window-to-workspace "stash" focus=false; }
}
