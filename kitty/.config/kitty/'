# Plassering
#edge left
#lines 40
#columns 60
edge bottom
lines 20
columns 120
# Marginer
margin bottom 30

# Utseende

# Oppførsel
focus_policy on-demand
hide_on_focus_loss no

# Wayland app-id for niri window rules
app_id kitty-quick-access


# Pek på session-filen
#windowkitty_override startup_session=~/.config/kitty/quick-access-hsplit.conf
kitty_override startup_session=~/.config/kitty/quick-access-vsplit.conf
# Sørg for at splits-layout er tilgjengelig
kitty_override enabled_layouts=splits,stack

