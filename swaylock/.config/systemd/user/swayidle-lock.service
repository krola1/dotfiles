[Unit]
Description=Lock screen before sleep using swayidle/swaylock
Documentation=man:swayidle(1) man:swaylock(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/swayidle -w before-sleep "/usr/bin/swaylock -f"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
